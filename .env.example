# Telegram Bot Configuration
# Obtain your Bot Token from @BotFather on Telegram (e.g. 1234567890:ABCdef...)
TELEGRAM_BOT_TOKEN=

# Obtain your Chat ID by messaging your bot or via @userinfobot / @getidsbot on Telegram (e.g. 123456789 or channel @mychannel)
# Multiple chat IDs can be separated by commas (e.g. 123456789,987654321)
TELEGRAM_CHAT_ID=

# Optional client-side environment variables (for static hosting deployments)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=